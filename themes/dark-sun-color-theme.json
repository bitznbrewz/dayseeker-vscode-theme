    "operator": "#FFAAB6",
    "namespace": "#F97AC3",
    "type": "#F97AC3",
    "class": "#F97AC3",
    "enum": "#F97AC3",
    "interface": "#FF8AD6",
    "struct": "#F97AC3",
    "typeParameter": "#FFAAB6",
    "parameter": "#FFAAB6",
    "variable": "#FFEFF2",
    "property": "#FF8AA0",
    "enumMember": "#FFB07F",
    "event": "#FF796C",
    "function": "#8FCEEE",
    "method": "#8FCEEE",
    "decorator": "#FF796C",
    "macro": "#FF796C",
    "label": "#FF8CD1",
    "module": "#F97AC3",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    },
    "variable.defaultLibrary": "#69BEDB",
    "function.defaultLibrary": "#69BEDB",
    "method.defaultLibrary": "#69BEDB",
    "class.defaultLibrary": "#69BEDB",
    "type.defaultLibrary": "#69BEDB",
    "property.defaultLibrary": "#69BEDB",
    "variable.builtin": "#69BEDB",
    "function.builtin": "#69BEDB",
    "class.builtin": "#69BEDB",
    "type.builtin": "#69BEDB",
    "parameter.self": {
      "foreground": "#69BEDB",
      "fontStyle": "italic"
    },
    "parameter.cls": {
      "foreground": "#69BEDB",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#64A3CB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.word",
        "keyword.operator.logical",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.instanceof",
        "keyword.operator.typeof",
        "keyword.operator.delete"
      ],
      "settings": {
        "foreground": "#FF8CD1"
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.default",
        "keyword.control.as",
        "keyword.other.import",
        "keyword.other.from",
        "keyword.import",
        "support.other.module",
        "entity.name.module",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#FF8CD1"
      }
    },
    {
      "name": "Module names",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.other.module",
        "variable.other.module"
      ],
      "settings": {
        "foreground": "#F97AC3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#FF7B8E"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FF8E85"
      }
    },
    {
      "name": "Embedded expressions reset to text",
      "scope": [
        "meta.template.expression",
        "meta.interpolation",
        "meta.embedded",
        "source.embedded"
      ],
      "settings": {
        "foreground": "#FFEFF2"
      }
    },
    {
      "name": "Template and f-string braces",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation",
        "punctuation.section.embedded",
        "constant.character.format.placeholder",
        "constant.other.placeholder",
        "storage.type.format"
      ],
      "settings": {
        "foreground": "#FFB07F"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "constant.other.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp",
        "keyword.operator.negation.regexp",
        "string.regexp.character-class"
      ],
      "settings": {
        "foreground": "#FF796C"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFB07F"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.terminator",
        "punctuation.section.braces",
        "punctuation.section.brackets",
        "punctuation.section.parens",
        "punctuation.section.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#FFAAB6"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "variable.other.function",
        "entity.name.function.member",
        "meta.function-call variable.other.property",
        "meta.method-call variable.other.property",
        "meta.function-call entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": {
        "foreground": "#8FCEEE"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "support.function.builtin",
        "support.function.magic",
        "support.type.builtin",
        "support.class.builtin",
        "support.variable.magic",
        "variable.language",
        "variable.language.special",
        "support.variable"
      ],
      "settings": {
        "foreground": "#69BEDB"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#F97AC3"
      }
    },
    {
      "name": "Interfaces and type aliases",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#FF8AD6"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "punctuation.decorator",
        "meta.decorator",
        "storage.type.annotation",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#FF796C"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#FFAAB6"
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "punctuation.support.type.property-name"
      ],
      "settings": {
        "foreground": "#FF8AA0"
      }
    },
    {
      "name": "JSX and HTML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#FF8CD1"
      }
    },
    {
      "name": "JSX and HTML attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#FF8AA0"
      }
    },
    {
      "name": "CSS class and id selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#F97AC3"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FF5452"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#64A3CB",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": {
        "foreground": "#75C07F"
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": {
        "foreground": "#FF5452"
      }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": {
        "foreground": "#FFB07F"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "punctuation.definition.heading"],
      "settings": {
        "foreground": "#FF8CD1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": {
        "foreground": "#FFEFF2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": {
        "foreground": "#FFAAB6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code", "punctuation.definition.raw", "punctuation.definition.markdown"],
      "settings": {
        "foreground": "#FFB07F"
      }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "markup.underline"],
      "settings": {
        "foreground": "#8FCEEE"
      }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#64A3CB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list punctuation",
      "scope": ["punctuation.definition.list.markdown"],
      "settings": {
        "foreground": "#FF7B8E"
      }
    }
  ]
}
